rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/weekSummaries/{weekId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/monthGoals/{monthId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/noteCategories/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/wellness/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/actionLogs/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/videoCategories/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/music/{musicId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/musicCategories/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/trainingVideos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/trainingVideoCategories/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/appLinks/{appId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
